{
  "name": "interstellar-voyage-simulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "package:static": "node scripts/package-static.mjs",
    "build": "npm run build:ts && npm run package:static",
    "test": "npm run build:ts && node --test tests/*.test.mjs",
    "check": "npm run test && npm run build && npm run smoke",
    "smoke": "node --test tests/static-smoke.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
